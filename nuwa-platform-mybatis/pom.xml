<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>nuwa-platform</artifactId>
        <groupId>com.study.nuwa</groupId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>nuwa-platform-mybatis</artifactId>
    <name>${project.artifactId}</name>
    <version>1.0-SNAPSHOT</version>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <packaging>jar</packaging>
    <description>管理系统需要用到的持久层框架</description>

    <dependencies>
        <dependency>
            <groupId>com.study.nuwa</groupId>
            <artifactId>nuwa-platform-base</artifactId>
        </dependency>
        <dependency>
            <groupId>com.study.nuwa</groupId>
            <artifactId>nuwa-platform-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>com.study.nuwa</groupId>
            <artifactId>nuwa-platform-swagger</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
        </dependency>
        <!--
            JSqlParser: MyBatis Plus 3.5.9 将 TenantLineInnerInterceptor / PaginationInnerInterceptor /
            BlockAttackInnerInterceptor 等依赖 JSqlParser 的类移到了独立的 jsqlparser 模块中
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.9</version>
        </dependency>

    </dependencies>

</project>