<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>nuwa-platform</artifactId>
        <groupId>com.study.nuwa</groupId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>nuwa-platform-cloud</artifactId>
    <name>${project.artifactId}</name>
    <version>1.0-SNAPSHOT</version>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <packaging>jar</packaging>

    <dependencies>
        <!-- 启动 bootstrap.yml 加载（Spring Cloud 2022+ 起需显式引入） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <!-- 为了使用HttpServletRequest和HttpServletResponse -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.study.nuwa</groupId>
            <artifactId>nuwa-platform-nacos</artifactId>
        </dependency>
        <!-- OpenFeign 微服务调用解决方案-->
        <dependency>
            <groupId>com.study.nuwa</groupId>
            <artifactId>nuwa-platform-feign</artifactId>
        </dependency>
        <dependency>
            <groupId>com.study.nuwa</groupId>
            <artifactId>nuwa-platform-base</artifactId>
        </dependency>
        <!-- Sentinel 高可用流量防护组件（提供 dashboard client，规则持久化可另行加 sentinel-datasource-nacos） -->
        <dependency>
            <groupId>com.study.nuwa</groupId>
            <artifactId>nuwa-platform-sentinel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.study.nuwa</groupId>
            <artifactId>nuwa-platform-redis</artifactId>
        </dependency>
        <!-- AOP 用于 @Aspect 防重复提交等切面（必须传递：本模块就提供 Aspect 类） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
    </dependencies>
</project>